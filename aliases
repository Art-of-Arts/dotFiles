function monitorBrightness() {
  if [[ -n "$1" ]]; then
    ddcutil --display 1 setvcp 0x10 $1
    ddcutil --display 2 setvcp 0x10 $1
  else
    echo "must provide a numerical value from 0-100"
  fi
}
alias color="colour"
colour() {
  perl -e 'foreach $a(@ARGV){print "\e[48:2::".join(":",unpack("C*",pack("H*",$a)))."m \e[49m "};print "\n"' "$@"
}

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

function dlNOW() {
  if [[ -z "$1" ]]; then
    echo "Bad argument: Missing url string"
    exit 1
  fi
  wget -c "$1"
}

function gamma() {
  if [[ -n "$1" ]]; then
    BRIGHTNESS="$1"
  else
    BRIGHTNESS=100
  fi
  hyprctl hyprsunset gamma $BRIGHTNESS
  unset BRIGHTNESS
}

function temperature() {
  if [[ -n "$1" ]]; then
    hyprctl hyprsunset temperature "$1"
  else
    hyprctl hyprsunset identity
  fi
}

function mntcparty() {
  if [[ -f "~/.rclone.pid" ]]; then
    kill -9 $(cat ~/.rclone.pid)
    rm ~/.rclone.pid
  else
    rclone mount --vfs-cache-mode writes --dir-cache-time 5s local-Storanator-9001: /mnt/Storenator9001/ --no-check-certificate --allow-non-empty &>/dev/null &
    echo "$!" >~/.rclone.pid
  fi
}

function inhibit() {
  FDATAinhibits=""
  if [[ "$#" == 0 ]]; then
    FDATAinhibits="idle:sleep:shutdown:"
    finhibits="idle, sleep, shutdown, "
  else
    for opt in "$@"; do
      case "$opt" in
      i)
        FDATAinhibits+="idle:"
        ;;
      s)
        FDATAinhibits+="sleep:"
        ;;
      p)
        FDATAinhibits+="shutdown:"
        ;;
      ? | help | h)
        printf 'options are:\ni -> idle\ns -> sleep\np -> poweroff\nh -> help\nyou can chain options like so:\ninhibit p s\n'
        unset FDATAinhibits opt opts
        return 0
        ;;
      *)
        printf 'unknown option: %s\n' "$opt" >&2
        unset FDATAinhibits opt opts
        return 1
        ;;
      esac
    done
  fi
  FDATAinhibits=${FDATAinhibits%:}
  systemd-inhibit --what="$FDATAinhibits" --who="$TERM" --why="manually invoked" \
    sh -c "echo inhibiting ${FDATAinhibits//:/, }; echo in terminal $TERM; while read -n1 -s; do echo exiting; break; done"
  unset FDATAinhibits opt opts
}

function holoport() {
  cmd='ssh -N '
  for U_PORT in $@; do
    if [[ $U_PORT =~ ^[0-9]+$ ]]; then
      cmd+="-L $U_PORT:172.0.0.1:$U_PORT "
    else
      printf '`%s` is not a number, cannot port forward a `%s`\n' "$U_PORT" "$U_PORT" >&2
      return 1
    fi
  done
  if [[ "$(uname -n)" == "holo-overlord" ]]; then
    printf "this is overlord, port forward from another computer!\n" >&2
    return 1
    unset cmd U_PORT
  fi
  eval "$cmd holo-overlord"
  unset cmd U_PORT
}
