// INFO: Input mapping!
// Input device configuration.
// Find the full list of options on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Input

prefer-no-csd

input {
    keyboard {
        xkb {
            layout "gb,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
        }

        numlock
    }

    touchpad {
        // off
        tap
        dwt
        dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="10%"
    warp-mouse-to-focus
}

switch-events {
  lid-close {
    spawn "bash" "-c" "noctalia msg session lock; playerctl --all-players pause; systemctl sleep"
  }
}

// INFO: MONITORS!
// https://niri-wm.github.io/niri/Configuration:-Outputs

include "monitor.kdl"

// INFO: windows & aesthetics
// Settings that influence how windows are positioned and sized.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Layout

blur {
  // off
  passes 3
  offset 3.0
  noise 0.25
  saturation 1.5
}

layout {
  // Set gaps around windows in logical pixels.
  gaps 5
  center-focused-column "never"
  //
  // You can customize the widths that "switch-preset-column-width" (Mod+R) toggles between.
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66666
  }

  // You can also customize the heights that "switch-preset-window-height" (Mod+Ctrl+Shift+R) toggles between.
  preset-window-heights {
    proportion 0.35
    proportion 0.5
    proportion 0.65
    proportion 1.0
  }

  // You can change the default width of the new windows.
  default-column-width { proportion 0.5; }

  focus-ring {
    off
    // active-color "#ffb4ff"
    // inactive-color "#1e1e1e"
    //
    // urgent-color "#c4a7e7"
  }

  border {
    // off

    width 2
    // active-color "#ffb4ff"
    // inactive-color "#1e1e1e"
    //
    // urgent-color "#c4a7e7"

  }

  // You can enable drop shadows for windows.
  shadow {
    // on

    // draw-behind-window true

    softness 30
    spread 5
    offset x=0 y=5

    color "#0007"
  }

  tab-indicator {
    on
  }

  struts {
    left 4
    right 4
    top 4
    bottom 4
  }
}

// INFO: cursor!
// more info can be found here https://niri-wm.github.io/niri/Configuration%3A-Miscellaneous.html#cursor
cursor {
  xcursor-theme "Kirispica"
  xcursor-size 12
  hide-after-inactive-ms 10000
}

// INFO: overview
// https://niri-wm.github.io/niri/Configuration%3A-Miscellaneous.html#overview
overview {
  backdrop-color "#1e1e1e"
  zoom 0.50
}

// INFO: Environment Variables
// https://niri-wm.github.io/niri/Configuration%3A-Miscellaneous.html#Environment
environment {
  GTK_THEME "rose-pine-gtk"
  GTK_USE_PORTAL "1"

  QT_QPA_PLATFORMTHEME "kde"
  QT_STYLE_OVERRIDE "kvantum"
  QT_QPA_PLATFORM "wayland;xcb"
  QT_AUTO_SCREEN_SCALE_FACTOR "1"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"

  ELECTRON_OZONE_PLATFORM_HINT "auto"

  // GBM_BACKEND,nvidia-drm
  // __GLX_VENDOR_LIBRARY_NAME,nvidia
  // LIBVA_DRIVER_NAME,nvidia
}

// INFO: autostart & maintanence
// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
// See the binds section below for more spawn examples.

// This line starts waybar, a commonly used bar for Wayland compositors.
spawn-sh-at-startup "noctalia"

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
    hide-not-bound
}

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
screenshot-path "~/Pictures/Screenshots/Screenshot-%Y-%m-%d-%H%M%S.png"

// Animation settings.
// The wiki explains how to configure individual animations:
// https://niri-wm.github.io/niri/Configuration:-Animations
animations {}

// INFO: WINDOW RULES!
// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

window-rule {
  draw-border-with-background false
  geometry-corner-radius 12
  clip-to-geometry true
  background-effect { blur true; xray false; }
}

window-rule { // blcok from screencapture add a "/-" in front to disable
    match app-id=r#"^Bitwarden$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    match app-id=r#"^zen$"# title="- Gmail "
    match app-id=r#"^zen$"# title="Bitwarden"
    match app-id=r#"^zen$"# title="Art's Sotorenator 9001"

    block-out-from "screen-capture"
    // block-out-from "screen"

    tab-indicator {
      inactive-color "#ff8080"
    }

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

window-rule { // make the silly pointer thinggy work
  match app-id=r#"^org.kde.kdeconnect.daemon$"#

  border { off; }
  shadow { off; }
  default-column-width { proportion 1.0; }
  default-window-height { proportion 1.0; }
  // default-floating-position x=0 y=0
  background-effect { blur false; xray false; }
  open-floating true
  open-focused false
  // open-maximized-to-edges true
  open-fullscreen false
}

window-rule { // open these to float please!
  match app-id=r#"ghostty$"# title="^*float-me-please!*$"
  match app-id=r#"zen$"# title="^Picture-in-Picture$"
  open-floating true
}

window-rule { // specifically for noctalia
  match app-id="dev.noctalia.Noctalia.Settings"
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
  open-floating true
}

window-rule {
  match title="Kando Menu"
  open-floating true
  focus-ring { off; }
  border { off; }
  shadow { off; }
  default-floating-position x=0 y=0
  background-effect { blur false; }
}

/-window-rule { // silly rule i just keep around
  match is-floating=true
  baba-is-float true
}

// INFO: layer-rules!
// which are not window-rules but are layer-rules, they're not to be confused with window-rules

layer-rule {
  match namespace="^noctalia-backdrop*"
  place-within-backdrop true
}

/-layer-rule {
  match layer="top"
  match layer="overlay"

  background-effect{ blur true; }
}

// INFO: Keybinds

include "keybinds.kdl"

// INFO: noctalia theming

include "noctalia.kdl"
