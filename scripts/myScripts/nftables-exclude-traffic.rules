define HOST_PORTS = { 22, 9 }
define DOCKER_PORTS = { 1302, 30000 }

table inet excludeTraffic {
  chain allowIncoming {
    type filter hook input priority -100; policy accept;
    iifname "enp9s0" tcp dport $HOST_PORTS ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
  }

  chain allowOutgoing {
    type route hook output priority -100; policy accept;
    tcp sport $HOST_PORTS ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
  }

  chain excludeDockerTraffic {
    type filter hook prerouting priority -150; policy accept;

    iifname "docker0" tcp dport $DOCKER_PORTS ct mark set 0x00000f41 meta mark set 0x6d6f6c65;
    iifname "docker0" udp dport $DOCKER_PORTS ct mark set 0x00000f41 meta mark set 0x6d6f6c65;

    ct mark 0x00000f41 meta mark set 0x6d6f6c65;
  }
}
